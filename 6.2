#include <stdio.h>
#include <ctype.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char x) {
    stack[++top] = x;
}

char pop() {
    return stack[top--];
}

int precedence(char x) {
    if (x == '^')
        return 3;
    if (x == '*' || x == '/')
        return 2;
    if (x == '+' || x == '-')
        return 1;
    return 0;
}

int main() {
    char exp[MAX];
    char result[MAX];
    int i, j = 0;

    scanf("%s", exp);

    for (i = 0; exp[i] != '\0'; i++) {
        if (isalnum(exp[i])) {
            result[j++] = exp[i];
        }
        else if (exp[i] == '(') {
            push(exp[i]);
        }
        else if (exp[i] == ')') {
            while (stack[top] != '(')
                result[j++] = pop();
            pop();
        }
        else {
            while (top != -1 && stack[top] != '(' &&
                   precedence(stack[top]) >= precedence(exp[i]))
                result[j++] = pop();

            push(exp[i]);
        }
    }

    while (top != -1)
        result[j++] = pop();

    result[j] = '\0';

    printf("%s", result);

    return 0;
}
